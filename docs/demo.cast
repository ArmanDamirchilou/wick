[29.928, "o", "\r\n"]
[29.978, "o", "If you are trapped under rubble, tap steadily on a pipe or a wall so rescuers can hear you.\r\n"]
[30.028, "o", "Do not shout unless you have no other option: shouting wastes energy and makes you breathe\r\n"]
[30.078, "o", "in dangerous dust. Cover your mouth with cloth to filter the air.\r\n"]
[30.878, "o", "\r\n\u001b[33m# …and when it isn't in the document, it says so\u001b[0m\r\n"]
